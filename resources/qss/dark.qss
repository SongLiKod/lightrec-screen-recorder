/* LightRec dark theme - keeps the brand blue accent */
QWidget {
    color: #e6edf6;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
}

QMainWindow, QWidget#mainWindow, QDialog {
    background: #171b22;
}

QWidget#navPanel {
    background: #1c212a;
    border-right: 1px solid #262d38;
}

QLabel#appTitle {
    font-size: 20px;
    font-weight: 700;
    color: #f1f5fb;
}

QLabel#appSubtitle {
    color: #7f8b9c;
    font-size: 11px;
}

QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #f1f5fb;
}

QLabel#mutedLabel, QLabel#hintLabel {
    color: #8a96a8;
    font-size: 12px;
}

QLabel#valueLabel {
    color: #5aa9f5;
    font-weight: 600;
}

QLabel#statusLabel {
    color: #a6b2c3;
}

QFrame#card {
    background: #1e242d;
    border: 1px solid #2a323e;
    border-radius: 12px;
}

QPushButton {
    background: #252c36;
    border: 1px solid #333d4b;
    border-radius: 8px;
    padding: 7px 14px;
    color: #dbe4ef;
}

QPushButton:hover {
    border-color: #2d8cf0;
    color: #6db4f8;
}

QPushButton:pressed {
    background: #1d2a3a;
}

QPushButton:disabled {
    color: #606c7c;
    border-color: #2b333e;
    background: #1d222a;
}

QPushButton#modeButton {
    background: #1a2028;
    border: 1px solid #333d4b;
    border-radius: 10px;
    color: #a9b5c5;
    padding: 8px 12px;
    font-size: 13px;
}

QPushButton#modeButton:hover {
    border-color: #2d8cf0;
    background: #1d2733;
}

QPushButton#modeButton:checked {
    background: #1f2f43;
    border: 2px solid #2d8cf0;
    color: #6db4f8;
    font-weight: 600;
}

QPushButton#primaryButton {
    background: #2d8cf0;
    border: 0;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background: #3d9bf5;
}

QPushButton#primaryButton:disabled {
    background: #2a4d73;
    color: #9db6d0;
}

QPushButton#dangerButton {
    background: #3a2427;
    border: 1px solid #553237;
    color: #ff8f88;
}

QPushButton#dangerButton:hover {
    background: #482a2e;
}

QPushButton#recordButton {
    background: #2d8cf0;
    border: 0;
    border-radius: 24px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    padding: 12px 34px;
}

QPushButton#recordButton:hover {
    background: #3d9bf5;
}

QPushButton#recordButton[recording="true"] {
    background: #e5484d;
}

QPushButton#navButton {
    text-align: left;
    padding: 10px 14px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #a9b5c5;
    font-size: 14px;
}

QPushButton#navButton:hover {
    background: #232b36;
    color: #6db4f8;
}

QPushButton#navButton:checked {
    background: #1f2f43;
    color: #6db4f8;
    font-weight: 600;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTimeEdit, QKeySequenceEdit {
    background: #161b22;
    border: 1px solid #333d4b;
    border-radius: 7px;
    padding: 6px 9px;
    color: #e6edf6;
    selection-background-color: #2d8cf0;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QTimeEdit:focus, QKeySequenceEdit:focus {
    border-color: #2d8cf0;
}

QLineEdit:disabled, QComboBox:disabled {
    color: #66717f;
    background: #1b2028;
}

QComboBox::drop-down {
    border: 0;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #1e242d;
    border: 1px solid #333d4b;
    selection-background-color: #1f2f43;
    selection-color: #6db4f8;
    outline: 0;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a4554;
    border-radius: 4px;
    background: #161b22;
}

QCheckBox::indicator:checked {
    background: #2d8cf0;
    border-color: #2d8cf0;
}

QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a4554;
    border-radius: 8px;
    background: #161b22;
}

QRadioButton::indicator:checked {
    border: 5px solid #2d8cf0;
    background: #161b22;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2b333f;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #2d8cf0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #2d8cf0;
}

QTableWidget {
    background: #1b2028;
    border: 1px solid #2a323e;
    border-radius: 10px;
    gridline-color: #262e39;
    selection-background-color: #1f2f43;
    selection-color: #e6edf6;
    alternate-background-color: #1e242d;
}

QTableWidget::item {
    padding: 6px;
}

QHeaderView::section {
    background: #202731;
    border: 0;
    border-bottom: 1px solid #2a323e;
    padding: 8px;
    color: #98a5b6;
    font-weight: 600;
}

QScrollArea {
    border: 0;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a4554;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #4b5768;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #3a4554;
    border-radius: 5px;
    min-width: 28px;
}

QTabWidget::pane {
    border: 1px solid #2a323e;
    border-radius: 10px;
    background: #1e242d;
}

QTabBar::tab {
    background: transparent;
    padding: 8px 16px;
    color: #98a5b6;
}

QTabBar::tab:selected {
    color: #6db4f8;
    font-weight: 600;
    border-bottom: 2px solid #2d8cf0;
}

QToolTip {
    background: #0f141b;
    color: #e6edf6;
    border: 1px solid #333d4b;
    padding: 6px 8px;
    border-radius: 6px;
}

QListWidget#toolList {
    background: #1b2028;
    border: 1px solid #2a323e;
    border-radius: 10px;
    outline: 0;
    padding: 6px;
}

QListWidget#toolList::item {
    padding: 10px 12px;
    border-radius: 7px;
    color: #a9b5c5;
}

QListWidget#toolList::item:selected {
    background: #1f2f43;
    color: #6db4f8;
}

QPlainTextEdit#logView, QTextEdit#logView {
    background: #141920;
    border: 1px solid #2a323e;
    border-radius: 8px;
    color: #9aa8b9;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QProgressBar {
    border: 0;
    border-radius: 4px;
    background: #262e39;
    text-align: center;
    color: #a9b5c5;
    height: 10px;
}

QProgressBar::chunk {
    background: #2d8cf0;
    border-radius: 4px;
}

QWidget#floatingToolbar {
    background: rgba(15, 20, 27, 240);
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 12px;
}

QWidget#floatingToolbar QLabel {
    color: #e9eff8;
}

QWidget#floatingToolbar QToolButton {
    color: #e9eff8;
    border: 0;
    border-radius: 7px;
    padding: 5px 8px;
    background: transparent;
}

QWidget#floatingToolbar QToolButton:hover {
    background: rgba(255, 255, 255, 26);
}

QWidget#floatingToolbar QToolButton:checked {
    background: #2d8cf0;
    color: #ffffff;
}

QWidget#annotationToolbar {
    background: rgba(12, 17, 24, 240);
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 10px;
}

QWidget#annotationToolbar QToolButton {
    color: #e9eff8;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font-size: 15px;
}

QWidget#annotationToolbar QToolButton:hover {
    background: rgba(255, 255, 255, 26);
}

QWidget#annotationToolbar QToolButton:checked {
    background: #2d8cf0;
    color: #ffffff;
}

QWidget#annotationToolbar QSpinBox {
    background: rgba(255, 255, 255, 18);
    border: 1px solid rgba(255, 255, 255, 36);
    color: #e9eff8;
}

QGroupBox {
    border: 1px solid #2a323e;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 8px;
    background: #1e242d;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #98a5b6;
    font-weight: 600;
}

QMenu {
    background: #1e242d;
    border: 1px solid #333d4b;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 18px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #1f2f43;
    color: #6db4f8;
}
