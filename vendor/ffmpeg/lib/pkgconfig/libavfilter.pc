prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 12.5.100
Requires: 
Requires.private: libswscale >= 10.2.100, libavformat >= 63.11.101, libavcodec >= 63.2.100, libswresample >= 7.3.101, libavutil >= 61.16.100
Conflicts:
Libs: -L${libdir}  -lavfilter 
Cflags: -I${includedir}
