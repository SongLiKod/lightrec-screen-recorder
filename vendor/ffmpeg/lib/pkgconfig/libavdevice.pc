prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 63.2.100
Requires: 
Requires.private: libavfilter >= 12.5.100, libswscale >= 10.2.100, libavformat >= 63.11.101, libavcodec >= 63.2.100, libswresample >= 7.3.101, libavutil >= 61.16.100
Conflicts:
Libs: -L${libdir}  -lavdevice 
Cflags: -I${includedir}
